FROM nginx:alpine

# Build from the repository's top folder:
#   docker build -f assignment-4/Dockerfile -t your_username/leaflet-intro .
# Paths below are relative to that folder.

# The starter Leaflet map, served at http://localhost:8880/getting-started.html
COPY getting-started.html /usr/share/nginx/html/getting-started.html

